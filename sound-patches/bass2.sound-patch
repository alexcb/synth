[osc1]
type=sine
freq=key_freq*0.5+osc5*key_freq*0.01 + key_freq*pitch*0.059463 # TODO need to support parenthesis to make this cleaner
input=osc2*0.7*c1
drive=1+velocity*velocity*5
output=1.0

[osc2]
type=sine
freq=key_freq*1.01
input=osc3*0.7*c2
attack=0.03
decay=0.8
sustain=0.5
release=0.1
output=0.00

[osc3]
type=sine
freq=key_freq*1.03
attack=0.1
decay=0.4
sustain=0.3
release=0.1
output=0.00

[osc5]
type=random_uniform
freq=1.0
output=0.00
